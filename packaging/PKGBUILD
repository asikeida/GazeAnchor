# Maintainer: local
pkgname=gaze-anchor-git
pkgver=r1.d4cb2555e8f6
pkgrel=1
pkgdesc='Visual stabilization overlay for Linux desktop sessions'
arch=('x86_64')
url='https://github.com/zjut-gwb/MotionStabilizer-Linux'
license=('MIT')
provides=('gaze-anchor')
conflicts=('gaze-anchor')
depends=(
  'gcc-libs'
  'glibc'
  'kglobalaccel'
  'libx11'
  'libxfixes'
  'layer-shell-qt'
  'qt6-base'
)
makedepends=(
  'cmake'
  'git'
  'pkgconf'
)
source=('GazeAnchor::git+https://github.com/zjut-gwb/MotionStabilizer-Linux.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/GazeAnchor"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=12 HEAD)"
}

prepare() {
  cd "$srcdir/GazeAnchor"
  rm -rf build
}

build() {
  cmake -S "$srcdir/GazeAnchor" -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_PROFILE=FULL
  cmake --build "$srcdir/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
